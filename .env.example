# GitHub Personal Access Token.
# Scopes: none. The app only reads public data, so an unscoped token is enough.
# Without it you get 60 requests/hour; with it, 5,000.
GITHUB_TOKEN=

# Claude API key, used to generate the summaries.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5.
ANTHROPIC_MODEL=

# Optional. Where the summary cache and read state are written.
# Defaults to ./.data
DATA_DIR=
