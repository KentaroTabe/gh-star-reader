# --- GitHub -----------------------------------------------------------------
# Personal Access Token. Scopes: none — the app only reads public data, so an
# unscoped token is enough. Without it you get 60 requests/hour; with it, 5,000.
GITHUB_TOKEN=

# --- Model provider ---------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. Defaults are Google
# AI Studio's free tier. Confirm the current model ID before you start:
# https://aistudio.google.com/
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Other providers, for reference. Base URL and model must be changed together.
#   Groq         https://api.groq.com/openai/v1
#   Cerebras     https://api.cerebras.ai/v1
#   OpenRouter   https://openrouter.ai/api/v1        (models ending in :free)
#   GitHub Models https://models.github.ai/inference (8K input cap — see README)

# --- Optional ---------------------------------------------------------------
# Send private repository contents to the model provider. Off by default:
# free tiers often reserve the right to train on prompts.
ALLOW_PRIVATE_REPOS=

# Where the summary cache and read state are written. Defaults to ./.data
DATA_DIR=
