# --- GitHub -----------------------------------------------------------------
# Personal Access Token. Scopes: none — the app only reads public data, so an
# unscoped token is enough. Without it you get 60 requests/hour; with it, 5,000.
GITHUB_TOKEN=

# --- Model provider ---------------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint works. Defaults are Google
# AI Studio's free tier. Confirm the current model ID before you start:
# https://aistudio.google.com/
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.6-flash

# Other providers, for reference. Base URL and model must be changed together.
#   Groq         https://api.groq.com/openai/v1
#   Cerebras     https://api.cerebras.ai/v1
#   OpenRouter   https://openrouter.ai/api/v1        (models ending in :free)
#   GitHub Models https://models.github.ai/inference (8K input cap — see README)

# --- Optional ---------------------------------------------------------------
# Send private repository contents to the model provider. Off by default:
# free tiers often reserve the right to train on prompts.
ALLOW_PRIVATE_REPOS=

# --- Database ---------------------------------------------------------------
# libSQL. A file path runs entirely on this machine; a libsql:// URL is Turso.
# The default is a local file, so nothing needs setting up to run it here.
#   TURSO_DATABASE_URL=libsql://<db>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Lets `npm run invite` mint links against a running instance. Required for
# invite administration; unset means the admin endpoint stays off.
ADMIN_TOKEN=
BASE_URL=

# Hosts allowed to load dev assets, comma-separated. Only needed when you open
# the dev server by LAN address instead of localhost — without it every chunk
# comes back 403 and the page stops responding to clicks.
#   DEV_ORIGINS=192.168.0.7,192.168.0.7:3001
DEV_ORIGINS=
